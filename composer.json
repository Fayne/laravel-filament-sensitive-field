{
    "name": "fayne/laravel-filament-sensitive-field",
    "description": "A reusable sensitive-value reveal field for Filament forms.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "filament/actions": "^5.0",
        "filament/forms": "^5.0",
        "illuminate/support": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Fayne\\SensitiveField\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Fayne\\SensitiveField\\SensitiveFieldServiceProvider"
            ]
        }
    },
    "authors": [
        {
            "name": "Fayne Guo",
            "email": "fayne.guo@gmail.com"
        }
    ],
    "keywords": [
        "laravel",
        "filament",
        "sensitive-field"
    ],
    "require-dev": {
        "laravel/pint": "^1.27",
        "orchestra/testbench": "^11.0"
    },
    "scripts": {
        "lint": "@php tools/lint.php",
        "format": "pint --test",
        "format:fix": "pint",
        "check": [
            "@lint",
            "@format",
            "@test"
        ],
        "test": "phpunit -c phpunit.xml.dist"
    },
    "$schema": "https://getcomposer.org/schema.json",
    "support": {
        "email": "fayne.guo@gmail.com"
    }
}
